; M0 diagnostic module configuration. MQTT connectivity is planned for M1.
; Include this section in a configuration file actually loaded by OpenSimulator.
[OpenSimMQTT]
Enabled = true

; Confirmed local test broker (2026-10-31): 172.16.100.5:1883.
; Port 1883 is the standard plaintext MQTT listener; TLS is disabled for LAN testing.
BrokerHost = 172.16.100.5
BrokerPort = 1883
UseTLS = false

; Local test account username: opensim.
; Do not commit the test password to source control; configure it locally
; or supply it through an environment variable when M1 authentication is implemented.
Username = opensim
PasswordEnvironmentVariable = OPENSIM_MQTT_PASSWORD
