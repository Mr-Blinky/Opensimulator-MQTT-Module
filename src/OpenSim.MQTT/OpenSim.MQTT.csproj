<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <OpenSimBinPath Condition="'$(OpenSimBinPath)' == ''">D:\Opensim\Builds\rev-latest</OpenSimBinPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="OpenSim.Region.Framework">
      <HintPath>$(OpenSimBinPath)\OpenSim.Region.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenSim.Framework">
      <HintPath>$(OpenSimBinPath)\OpenSim.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Addins">
      <HintPath>$(OpenSimBinPath)\Mono.Addins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(OpenSimBinPath)\log4net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Nini">
      <HintPath>$(OpenSimBinPath)\Nini.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
